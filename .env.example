# Salin ke .env.local lalu isi. JANGAN commit file .env*.
APP_URL=http://localhost:3000
APP_ENV=development

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server saja

GEMINI_API_KEY=                     # server saja
GEMINI_MODEL_REFINE=                # keluarga Flash (cek nama terbaru di Google AI Studio)
GEMINI_MODEL_CHAT=                  # keluarga Flash-Lite
GEMINI_MODEL_FALLBACK=

IP_HASH_SALT=                       # >= 32 karakter acak
CRON_SECRET=
LOG_LEVEL=debug

TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
